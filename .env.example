# View https://docs.g0v0.top/lazer/reference/configurations.html for details.
HOST="0.0.0.0"
PORT=8000

MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_DATABASE="osu_api"
MYSQL_USER="osu_api"
MYSQL_PASSWORD="password"
MYSQL_ROOT_PASSWORD="password"
REDIS_URL="redis://127.0.0.1:6379"

JWT_SECRET_KEY="your_jwt_secret_here"
SERVER_URL="http://localhost:8000"
SENTRY_DSN="https://public@sentry.example.com/"
SP_SENTRY_DSN="https://public@sentry.example.com/"

FETCHER_CLIENT_ID=""
FETCHER_CLIENT_SECRET=""
FETCHER_SCOPES="public"

ENABLE_EMAIL_VERIFICATION=false
ENABLE_TOTP_VERIFICATION=true
ENABLE_SESSION_VERIFICATION=false
ENABLE_MULTI_DEVICE_LOGIN=true
MAX_TOKENS_PER_CLIENT=10
DEVICE_TRUST_DURATION_DAYS=30

ENABLE_RX=true
ENABLE_AP=true
ENABLE_SUPPORTER_FOR_ALL_USERS=true
ENABLE_ALL_BEATMAP_PP=true
SEASONAL_BACKGROUNDS=["url1","url2","url3"]

OSU_WEB_CLIENT_SECRET="your_osu_web_client_secret_here"
CORS_URLS='[]'
FRONTEND_URL

SAVE_REPLAYS=true

ENABLE_WIKI=true
WIKI_REPOSITORY="ppy/osu-wiki"
WIKI_BRANCH="master"
WIKI_CONTENT_ROOT="wiki"
WIKI_RAW_BASE_URL="https://raw.githubusercontent.com"
WIKI_LISTING_BASE_URL="https://api.github.com"
WIKI_GITHUB_TOKEN=""
WIKI_FALLBACK_LOCALE="en"
WIKI_CACHE_EXPIRE_SECONDS=300
WIKI_RESOURCE_CACHE_EXPIRE_SECONDS=3600
WIKI_REQUEST_TIMEOUT_SECONDS=10

# changelog & news, served from the content repository
ENABLE_CHANGELOG=true
ENABLE_NEWS=true
CONTENT_REPOSITORY="GooGuTeam/g0v0-news"
CONTENT_BRANCH="main"
CHANGELOG_CONTENT_ROOT="changelog"
NEWS_CONTENT_ROOT="news"
CONTENT_RAW_BASE_URL="https://raw.githubusercontent.com"
# Needed to enumerate builds and posts; empty disables both listings.
CONTENT_LISTING_BASE_URL="https://api.github.com"
CONTENT_GITHUB_TOKEN=""
# Where a post is edited, used for its `edit_url`.
CONTENT_WEB_BASE_URL="https://github.com"
CONTENT_CACHE_EXPIRE_SECONDS=300
CONTENT_LISTING_CACHE_EXPIRE_SECONDS=1800
CONTENT_INDEX_EXPIRE_SECONDS=600
CONTENT_REQUEST_TIMEOUT_SECONDS=10

ENABLE_SCREENSHOT_CLEANUP=false
SCREENSHOT_RETENTION_DAYS=30
